# ==========================================
# PPFlight VPS 补货监控配置文件 (.env)
# ==========================================

# -----------------
# 1. 运行模式配置
# -----------------
# 运行模式: daemon (常驻后台轮询) 或 once (单次运行退出，配合系统 crontab)
RUN_MODE=daemon

# 轮询检查间隔（单位：秒，默认 60 秒）
CHECK_INTERVAL=60

# 是否启用无头模式 (true / false，建议 false，抗 Cloudflare 识别效果更佳)
HEADLESS=false

# -----------------
# 2. Bark (iOS 推送)
# -----------------
# 填写 Bark App 中的设备 Key (例如 https://api.day.app/YOUR_KEY/ 则填写 YOUR_KEY)
BARK_KEY=

# Bark 自建服务器地址（可选，默认为官方 https://api.day.app）
BARK_SERVER=https://api.day.app

# Bark 消息分组名称
BARK_GROUP=PPFlight监控

# Bark 提示铃声 (如: minuet, bell, glass, chime)
BARK_SOUND=minuet

# -----------------
# 3. Telegram Bot 推送
# -----------------
# Telegram Bot Token (向 @BotFather 申请)
TELEGRAM_BOT_TOKEN=

# Telegram 接收消息的 Chat ID (个人 ID 或群组 ID)
TELEGRAM_CHAT_ID=

# -----------------
# 4. Chrome 路径 (可选)
# -----------------
# 如需指定特定 Chrome 可执行文件路径，取消注释：
# Windows 示例: CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
# Linux 示例: CHROME_PATH="/usr/bin/google-chrome"
